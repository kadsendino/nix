layout {

    focus-ring {
        active-color   "#eddd8e"
        inactive-color "#2d2b33"
        urgent-color   "#ed7979"
    }

    border {
        active-color   "#eddd8e"
        inactive-color "#2d2b33"
        urgent-color   "#ed7979"
    }

    shadow {
        color "#42424270"
    }

    tab-indicator {
        active-color   "#eddd8e"
        inactive-color "#bc9e0d"
        urgent-color   "#ed7979"
    }

    insert-hint {
        color "#eddd8e80"
    }
}

recent-windows {
    highlight {
        active-color "#eddd8e"
        urgent-color "#ed7979"
    }
}
